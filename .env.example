# OpenAI Configuration
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="gpt-4o-mini"

# Database Configuration
MONGO_URI="mongodb://mongo:27017"

# API Endpoints
PORTFOLIO_RESEARCH_API_URL="http://portfolio_research:8000/api/v1"
